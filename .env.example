# ==========================================================================
# PHARMASWAP — متغيرات البيئة / Environment Variables
# ==========================================================================
# التطبيق يعمل فوراً بدون أي مفاتيح (وضع محلي/بديل Local Fallback):
# البيانات تُحفظ في مجلد .data/ والصور في .data/uploads/ وتُخدم عبر /api/uploads/.
# بمجرد إضافة مفاتيح Supabase يتحول التطبيق تلقائياً لقاعدة البيانات السحابية.
# --------------------------------------------------------------------------
# The app boots instantly with ZERO keys (local fallback mode). Add Supabase
# keys to switch every query to your hosted Postgres project automatically.
# ==========================================================================

# --------------------------------------------------------------------------
# 1) SUPABASE — https://supabase.com/dashboard/project/_/settings/api
# --------------------------------------------------------------------------
# الخطوات / Steps:
#   1. أنشئ مشروعاً جديداً على Supabase (Region: eu-central-1 قريب من مصر).
#   2. افتح SQL Editor ونفّذ الملفين بالترتيب:
#        supabase/migrations/001_init.sql
#        supabase/migrations/002_seed_egypt_and_drugs.sql
#   3. انسخ Project URL و anon key و service_role key هنا.
#   4. أعد تشغيل السيرفر: npm run dev
#
# ملاحظة: service_role key يُستخدم فقط داخل Server Actions (لا يُرسل للمتصفح أبداً)
# ويُستخدم لتسجيل الدخول والكتابة. RLS مفعّل على كل الجداول في القاعدة.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --------------------------------------------------------------------------
# 2) CLOUDFLARE R2 — https://dash.cloudflare.com/?to=/:account/r2
# --------------------------------------------------------------------------
# الخطوات / Steps:
#   1. أنشئ Bucket باسم pharmaswap-media.
#   2. فعّل Public Access (r2.dev) أو اربط Custom Domain.
#   3. أنشئ R2 API Token بصلاحية Object Read & Write.
#   4. املأ المفاتيح التالية. إذا تركتها فارغة سيتم استخدام التخزين المحلي
#      تلقائياً (الرفع يعمل بدون أي إعداد خارجي).
#
# R2_PUBLIC_BASE_URL = رابط الـ Bucket العام بدون / في النهاية
# مثال: https://pub-xxxxxxxx.r2.dev  أو  https://media.pharmaswap.eg
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pharmaswap-media
R2_PUBLIC_BASE_URL=

# --------------------------------------------------------------------------
# 3) SESSION — مفتاح توقيع كوكيز الجلسة
# --------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production-pharmaswap-secret-key

# --------------------------------------------------------------------------
# 4) OPTIONAL — مسار تخزين الوضع المحلي (افتراضياً .data)
# --------------------------------------------------------------------------
# PHARMASWAP_DATA_DIR=
